generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          String    @default("CLIENT")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  providerProfile         ProviderProfile?
  serviceRequests         ServiceRequest[]
  responses               Response[]
  messages                Message[]
  subscription            Subscription?
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  reviewsGiven            Review[]    @relation("ReviewClient")
  reviewsReceived         Review[]    @relation("ReviewProvider")
  directInquiriesSent     DirectInquiry[] @relation("InquirySender")
  directInquiriesReceived DirectInquiry[] @relation("InquiryProvider")
  stories                 ProviderStory[]
  supplierIdentities      SupplierIdentity[]
  claimRequests           ClaimRequest[]     @relation("ClaimRequestUser")
  claimReviews            ClaimRequest[]     @relation("ClaimReviewedBy")

  @@map("users")
}

model ProviderProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  description           String?   @db.Text
  headline              String?
  services              String?   @db.Text
  priceFrom             Int?
  experienceYears       Int?
  offersInvoices        Boolean   @default(false)
  availableForUrgent    Boolean   @default(false)
  specializations       String    @default("[]")
  location              String?
  phone                 String?
  website               String?
  isActive              Boolean   @default(false)
  planType              String    @default("FREE")
  planExpiresAt         DateTime?
  images                String    @default("[]")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("provider_profiles")
}

model ServiceRequest {
  id                 String   @id @default(cuid())
  trackingToken      String   @unique @default(cuid())
  requestVerificationToken String?  @unique
  requestVerificationExpiresAt DateTime?
  contactVerifiedAt  DateTime?
  title              String
  description        String   @db.Text
  category           String
  location           String
  budget             String?
  status             String   @default("OPEN")
  acceptedResponseId String?
  clientId           String?
  clientEmail        String
  clientName         String
  clientPhone        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client    User?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  responses Response[]
  reviews   Review[]

  @@index([status])
  @@index([category])
  @@index([location])
  @@map("service_requests")
}

model Response {
  id         String   @id @default(cuid())
  requestId  String
  providerId String
  message    String   @db.Text
  price      Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider User           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  messages Message[]
  reviews  Review[]

  @@index([providerId])
  @@map("responses")
}

model Message {
  id         String   @id @default(cuid())
  responseId String
  senderId   String?
  senderName String?
  content    String   @db.Text
  createdAt  DateTime @default(now())

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  sender   User?    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  planType             String   @default("BASIC")
  status               String   @default("ACTIVE")
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?  @db.Text
  clientId   String?
  providerId String
  requestId  String
  responseId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client   User? @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider User  @relation("ReviewProvider", fields: [providerId], references: [id], onDelete: Cascade)
  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  response Response       @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([requestId, responseId])
  @@index([providerId])
  @@map("reviews")
}

model DirectInquiry {
  id           String   @id @default(cuid())
  providerId   String
  description  String   @db.Text
  budget       String?
  senderUserId String?
  senderEmail  String
  senderPhone  String?
  senderName   String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider User  @relation("InquiryProvider", fields: [providerId], references: [id], onDelete: Cascade)
  sender   User? @relation("InquirySender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([providerId, status])
  @@index([senderUserId])
  @@index([senderEmail])
  @@map("direct_inquiries")
}

model PendingDirectInquiry {
  id            String   @id @default(cuid())
  providerId    String
  description   String   @db.Text
  budget        String?
  senderEmail   String
  senderPhone   String?
  senderName    String?
  code          String
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  resendCount   Int      @default(0)
  lastSentAt    DateTime @default(now())
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([senderEmail])
  @@index([providerId, senderEmail])
  @@map("pending_direct_inquiries")
}

model PlatformSettings {
  id           String   @id @default("singleton")
  storyEnabled Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@map("platform_settings")
}

model ProviderStory {
  id            String   @id @default(cuid())
  providerId    String
  imageUrl      String
  imagePublicId String?
  text          String?  @db.VarChar(200)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  provider User @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, expiresAt])
  @@map("provider_stories")
}

// ═══════════════════════════════════════════════════════════════════════
// Imported taxonomy + supplier foundation (from paslaugos-crawler)
// ═══════════════════════════════════════════════════════════════════════

model Category {
  id             String   @id
  name           String
  slug           String   @unique
  parentId       String?
  rootId         String?
  depth          Int      @default(0)
  path           String   @default("")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  pageType       String?
  externalSource String?
  externalSlug   String?
  metadataJson   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  root            Category?  @relation("CategoryRoot", fields: [rootId], references: [id])
  rootDescendants Category[] @relation("CategoryRoot")
  aliases         CategoryAlias[]
  supplierLinks   SupplierCategoryLink[]

  @@index([parentId])
  @@index([rootId])
  @@index([depth])
  @@index([path])
  @@map("categories")
}

model CategoryAlias {
  id         String   @id @default(cuid())
  categoryId String
  aliasName  String
  aliasSlug  String?
  source     String?
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([aliasSlug])
  @@map("category_aliases")
}

model SupplierRecord {
  id                String   @id @default(cuid())
  displayName       String
  slug              String   @unique
  status            String   @default("unclaimed")
  sourceType        String   @default("imported")
  shortSummary      String?
  description       String?  @db.Text
  phonePublic       String?
  emailPublic       String?
  websiteUrl        String?
  city              String?
  companyCode       String?
  isVerified        Boolean  @default(false)
  heroImageUrl      String?
  galleryUrls       String?  @db.Text
  rating            Float?
  reviewCount       Int      @default(0)
  enrichedAt        DateTime?
  externalSource    String?
  externalSourceUrl String?
  metadataJson      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  categoryLinks  SupplierCategoryLink[]
  snapshots      SupplierSourceSnapshot[]
  claimRequests  ClaimRequest[]
  identities     SupplierIdentity[]

  @@index([status])
  @@index([city])
  @@index([externalSourceUrl])
  @@map("supplier_records")
}

model SupplierCategoryLink {
  id               String  @id @default(cuid())
  supplierRecordId String
  categoryId       String
  isPrimary        Boolean @default(false)
  confidenceScore  Float   @default(1.0)

  supplier SupplierRecord @relation(fields: [supplierRecordId], references: [id])
  category Category       @relation(fields: [categoryId], references: [id])

  @@unique([supplierRecordId, categoryId])
  @@index([supplierRecordId])
  @@index([categoryId])
  @@map("supplier_category_links")
}

model SupplierSourceSnapshot {
  id               String   @id @default(cuid())
  supplierRecordId String
  sourceName       String
  sourceUrl        String?
  rawTitle         String?
  rawText          String?  @db.Text
  rawMetadataJson  String?
  hash             String?
  capturedAt       DateTime @default(now())

  supplier SupplierRecord @relation(fields: [supplierRecordId], references: [id])

  @@index([supplierRecordId])
  @@index([sourceUrl])
  @@index([hash])
  @@map("supplier_source_snapshots")
}

model ClaimRequest {
  id                    String    @id @default(cuid())
  supplierRecordId      String
  requestedByEmail      String
  requestedByUserId     String?
  verificationMethod    String
  status                String    @default("pending")
  tokenHash             String    @unique
  expiresAt             DateTime
  emailVerifiedAt       DateTime?
  reviewedAt            DateTime?
  reviewedByUserId      String?
  submittedEvidenceJson String?
  reviewNotes           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  supplier    SupplierRecord @relation(fields: [supplierRecordId], references: [id])
  requestedBy User?          @relation("ClaimRequestUser", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedBy  User?          @relation("ClaimReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([supplierRecordId])
  @@index([status])
  @@index([requestedByEmail])
  @@index([expiresAt])
  @@map("claim_requests")
}

model SupplierIdentity {
  id                 String    @id @default(cuid())
  supplierRecordId   String
  userId             String?
  contactEmail       String
  ownershipStatus    String    @default("pending")
  verificationMethod String
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  supplier SupplierRecord @relation(fields: [supplierRecordId], references: [id])
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([supplierRecordId])
  @@index([userId])
  @@index([ownershipStatus])
  @@map("supplier_identities")
}
