generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String?
  role            String    @default("CLIENT")
  emailVerified   DateTime?
  phone           String?
  phoneVerifiedAt DateTime?
  image           String?
  lastSeenAt      DateTime?
  blocked         Boolean   @default(false)
  blockedAt       DateTime?
  adminNote       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts                Account[]
  providerProfile         ProviderProfile?
  serviceRequests         ServiceRequest[]
  responses               Response[]
  requestViews            RequestView[]
  messages                Message[]
  subscription            Subscription?
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  pendingSignInTokens     PendingSignInToken[]
  reviewsGiven            Review[]                 @relation("ReviewClient")
  reviewsReceived         Review[]                 @relation("ReviewProvider")
  directInquiriesSent     DirectInquiry[]          @relation("InquirySender")
  directInquiriesReceived DirectInquiry[]          @relation("InquiryProvider")
  stories                 ProviderStory[]
  supplierIdentities      SupplierIdentity[]
  claimRequests           ClaimRequest[]           @relation("ClaimRequestUser")
  claimReviews            ClaimRequest[]           @relation("ClaimReviewedBy")

  // Hot path: /meistrai listing filters `role = 'PROVIDER' AND emailVerified IS NOT NULL`.
  // Without this composite the planner does a full table scan.
  @@index([role, emailVerified])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model ProviderProfile {
  id                 String    @id @default(cuid())
  userId             String?   @unique
  slug               String?   @unique
  description        String?   @db.Text
  headline           String?
  services           String?   @db.Text
  priceFrom          Int?
  experienceYears    Int?
  offersInvoices     Boolean   @default(false)
  availableForUrgent Boolean   @default(false)
  specializations    String[]  @default([])
  location           String?
  phone              String?
  website            String?
  isActive           Boolean   @default(false)
  planType           String    @default("FREE")
  creditBalance      Int       @default(0)
  moderationStatus   String    @default("APPROVED")
  moderationReason   String?
  moderatedAt        DateTime?
  planExpiresAt      DateTime?
  images             String[]  @default([])

  // ── Absorbed from SupplierRecord — Phase 2: unified provider entity ──
  // A ProviderProfile now represents ANY provider: self-created (registered)
  // or imported from the paslaugos.lt catalog (claimed or not yet).
  displayName       String?
  status            String    @default("claimed") // claimed | unclaimed
  sourceType        String    @default("self_created") // self_created | imported
  shortSummary      String?
  publicEmail       String?
  heroImageUrl      String?
  companyCode       String?
  isVerified        Boolean   @default(false)
  isPremium         Boolean   @default(false)
  isYoungTalent     Boolean   @default(false)
  isGoat            Boolean   @default(false)
  rating            Float?
  reviewCount       Int       @default(0)
  externalSource    String?
  externalSourceUrl String?
  enrichedAt        DateTime?
  metadataJson      String?   @db.Text

  // ── SEO fields populated by AI (src/app/api/profile/ai-generate/route.ts) ──
  // seoTitle/seoDescription back the per-profile <title> and meta description
  // on /meistrai/[slug]. primaryService + primaryCity drive structured-data
  // (LocalBusiness.areaServed) and a fallback metadata formula for legacy
  // rows where AI hasn't run yet.
  seoTitle       String?
  seoDescription String?
  primaryService String?
  primaryCity    String?
  serviceArea    String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  claimRequests      ClaimRequest[]
  categories         ProviderProfileCategory[]
  creditTransactions CreditTransaction[]
  leadUnlocks        LeadUnlock[]

  @@index([specializations], type: Gin)
  @@index([moderationStatus])
  @@index([status])
  @@index([sourceType])
  @@index([externalSourceUrl])
  // Provider listing joins on `isActive = true AND moderationStatus = 'APPROVED'`
  // through the User → ProviderProfile relation. Composite avoids the
  // second filter step after the moderationStatus single-column index.
  @@index([isActive, moderationStatus])
  @@map("provider_profiles")
}

model ProviderProfileCategory {
  id                String   @id @default(cuid())
  providerProfileId String
  categoryId        String
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  // null  = free/base category (permanent, counts against the free limit).
  // future = paid unlock, active until this time.
  // past   = expired paid unlock — kept for history but no longer matches leads.
  expiresAt         DateTime?

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [id])

  @@unique([providerProfileId, categoryId])
  @@index([providerProfileId])
  @@index([categoryId])
  @@map("provider_profile_categories")
}

// Multi-category link table — a service request can have up to 3 curated
// categories. sortOrder 0 = primary (mirrored to the legacy categoryId column
// for backwards compatibility with code paths that still read the single FK).
model ServiceRequestCategory {
  id         String   @id @default(cuid())
  requestId  String
  categoryId String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category Category       @relation(fields: [categoryId], references: [id])

  @@unique([requestId, categoryId])
  @@index([requestId])
  @@index([categoryId])
  @@map("service_request_categories")
}

model ServiceRequest {
  id                           String    @id @default(cuid())
  trackingToken                String    @unique @default(cuid())
  requestVerificationToken     String?   @unique
  requestVerificationExpiresAt DateTime?
  contactVerifiedAt            DateTime?
  title                        String
  description                  String    @db.Text
  category                     String
  categoryId                   String?
  location                     String
  budget                       String?
  deadline                     String?
  attachmentUrls               String[]  @default([])
  status                       String    @default("OPEN")
  moderationStatus             String    @default("APPROVED")
  moderationReason             String?
  moderatedAt                  DateTime?
  acceptedResponseId           String?
  clientId                     String?
  clientEmail                  String
  clientName                   String
  clientPhone                  String?
  source                       String    @default("web") // "web" | "telegram"
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  client      User?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  categoryRef Category?                @relation(fields: [categoryId], references: [id])
  categories  ServiceRequestCategory[]
  responses   Response[]
  reviews     Review[]
  views       RequestView[]
  leadUnlocks LeadUnlock[]

  @@index([status])
  @@index([category])
  @@index([categoryId])
  @@index([location])
  @@index([moderationStatus, createdAt])
  @@map("service_requests")
}

model RequestView {
  id         String   @id @default(cuid())
  requestId  String
  providerId String
  createdAt  DateTime @default(now())

  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider User           @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([requestId, providerId])
  @@index([requestId])
  @@map("request_views")
}

model Response {
  id         String   @id @default(cuid())
  requestId  String
  providerId String
  message    String   @db.Text
  price      Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Conversation tracking — denormalized so the provider inbox can sort by
  // recent activity and flag unread threads without scanning all messages.
  lastMessageAt      DateTime  @default(now())
  providerLastReadAt DateTime  @default(now())
  clientLastReadAt   DateTime?

  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider User           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  messages Message[]
  reviews  Review[]

  @@index([providerId, lastMessageAt])
  @@map("responses")
}

model Message {
  id              String   @id @default(cuid())
  // A message belongs to exactly one thread: either a Response or a
  // DirectInquiry. Both are nullable; app code always sets exactly one.
  responseId      String?
  directInquiryId String?
  senderId        String?
  senderName      String?
  content         String   @db.Text
  createdAt       DateTime @default(now())

  response      Response?      @relation(fields: [responseId], references: [id], onDelete: Cascade)
  directInquiry DirectInquiry? @relation(fields: [directInquiryId], references: [id], onDelete: Cascade)
  sender        User?          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([directInquiryId])
  @@map("messages")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  planType             String    @default("BASIC")
  status               String    @default("ACTIVE")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// One-time auto-sign-in token issued during registration. Lives only in the
// registering browser tab; redeemable AFTER email verification completes so
// the original tab can sign the user in without re-asking for the password.
model PendingSignInToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pending_signin_tokens")
}

model Review {
  id               String    @id @default(cuid())
  rating           Int
  comment          String?   @db.Text
  clientId         String?
  providerId       String
  requestId        String
  responseId       String
  moderationStatus String    @default("APPROVED")
  moderationReason String?
  moderatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client   User?          @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider User           @relation("ReviewProvider", fields: [providerId], references: [id], onDelete: Cascade)
  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  response Response       @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([requestId, responseId])
  @@index([providerId])
  @@index([moderationStatus])
  @@map("reviews")
}

model DirectInquiry {
  id               String    @id @default(cuid())
  trackingToken    String    @unique @default(cuid())
  providerId       String
  description      String    @db.Text
  budget           String?
  senderUserId     String?
  senderEmail      String
  senderPhone      String?
  senderName       String?
  status           String    @default("NEW")
  moderationStatus String    @default("APPROVED")
  moderationReason String?
  moderatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Conversation tracking — a DirectInquiry is now a two-way message thread.
  lastMessageAt      DateTime  @default(now())
  providerLastReadAt DateTime  @default(now())
  clientLastReadAt   DateTime?

  provider User      @relation("InquiryProvider", fields: [providerId], references: [id], onDelete: Cascade)
  sender   User?     @relation("InquirySender", fields: [senderUserId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([providerId, status])
  @@index([providerId, lastMessageAt])
  @@index([senderUserId])
  @@index([senderEmail])
  @@index([moderationStatus])
  @@map("direct_inquiries")
}

model PendingDirectInquiry {
  id          String    @id @default(cuid())
  providerId  String
  description String    @db.Text
  budget      String?
  senderEmail String
  senderPhone String?
  senderName  String?
  code        String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  resendCount Int       @default(0)
  lastSentAt  DateTime  @default(now())
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderEmail])
  @@index([providerId, senderEmail])
  @@map("pending_direct_inquiries")
}

model RequestEmailVerification {
  id          String    @id @default(cuid())
  email       String    @unique
  code        String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  resendCount Int       @default(0)
  lastSentAt  DateTime  @default(now())
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("request_email_verifications")
}

model PhoneVerification {
  id          String    @id @default(cuid())
  phone       String    @unique
  codeHash    String
  userId      String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  resendCount Int       @default(0)
  lastSentAt  DateTime  @default(now())
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("phone_verifications")
}

model PlatformSettings {
  id                 String   @id @default("singleton")
  storyEnabled       Boolean  @default(true)
  emailTestMode      Boolean  @default(false)
  emailAllowlist     String[] @default([])
  freeStarterCredits Int      @default(3)
  updatedAt          DateTime @updatedAt

  @@map("platform_settings")
}

model ProviderStory {
  id               String    @id @default(cuid())
  providerId       String
  imageUrl         String
  imagePublicId    String?
  text             String?   @db.VarChar(200)
  moderationStatus String    @default("APPROVED")
  moderationReason String?
  moderatedAt      DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  provider User @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, expiresAt])
  @@index([moderationStatus])
  @@map("provider_stories")
}

// ═══════════════════════════════════════════════════════════════════════
// Imported taxonomy + supplier foundation (from paslaugos-crawler)
// ═══════════════════════════════════════════════════════════════════════

model Category {
  id             String   @id
  name           String
  slug           String   @unique
  parentId       String?
  rootId         String?
  depth          Int      @default(0)
  path           String   @default("")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  pageType       String?
  externalSource String?
  externalSlug   String?
  metadataJson   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent          Category?                 @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]                @relation("CategoryTree")
  root            Category?                 @relation("CategoryRoot", fields: [rootId], references: [id])
  rootDescendants Category[]                @relation("CategoryRoot")
  aliases         CategoryAlias[]
  supplierLinks   SupplierCategoryLink[]
  serviceRequests ServiceRequest[]
  requestLinks    ServiceRequestCategory[]
  providerLinks   ProviderProfileCategory[]

  @@index([parentId])
  @@index([rootId])
  @@index([depth])
  @@index([path])
  @@map("categories")
}

model CategoryAlias {
  id         String   @id @default(cuid())
  categoryId String
  aliasName  String
  aliasSlug  String?
  source     String?
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([aliasSlug])
  @@map("category_aliases")
}

model SupplierRecord {
  id                String    @id @default(cuid())
  displayName       String
  slug              String    @unique
  status            String    @default("unclaimed")
  sourceType        String    @default("imported")
  shortSummary      String?
  description       String?   @db.Text
  phonePublic       String?
  emailPublic       String?
  websiteUrl        String?
  city              String?
  companyCode       String?
  isVerified        Boolean   @default(false)
  heroImageUrl      String?
  galleryUrls       String?   @db.Text
  rating            Float?
  reviewCount       Int       @default(0)
  enrichedAt        DateTime?
  externalSource    String?
  externalSourceUrl String?
  metadataJson      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  categoryLinks SupplierCategoryLink[]
  snapshots     SupplierSourceSnapshot[]
  claimRequests ClaimRequest[]
  identities    SupplierIdentity[]

  @@index([status])
  @@index([city])
  @@index([externalSourceUrl])
  @@map("supplier_records")
}

model SupplierCategoryLink {
  id               String  @id @default(cuid())
  supplierRecordId String
  categoryId       String
  isPrimary        Boolean @default(false)
  confidenceScore  Float   @default(1.0)

  supplier SupplierRecord @relation(fields: [supplierRecordId], references: [id])
  category Category       @relation(fields: [categoryId], references: [id])

  @@unique([supplierRecordId, categoryId])
  @@index([supplierRecordId])
  @@index([categoryId])
  @@map("supplier_category_links")
}

model SupplierSourceSnapshot {
  id               String   @id @default(cuid())
  supplierRecordId String
  sourceName       String
  sourceUrl        String?
  rawTitle         String?
  rawText          String?  @db.Text
  rawMetadataJson  String?
  hash             String?
  capturedAt       DateTime @default(now())

  supplier SupplierRecord @relation(fields: [supplierRecordId], references: [id])

  @@index([supplierRecordId])
  @@index([sourceUrl])
  @@index([hash])
  @@map("supplier_source_snapshots")
}

model ClaimRequest {
  id                    String    @id @default(cuid())
  supplierRecordId      String?
  providerProfileId     String?
  requestedByEmail      String
  requestedByUserId     String?
  verificationMethod    String
  status                String    @default("pending")
  tokenHash             String    @unique
  expiresAt             DateTime
  emailVerifiedAt       DateTime?
  reviewedAt            DateTime?
  reviewedByUserId      String?
  submittedEvidenceJson String?
  reviewNotes           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  supplier        SupplierRecord?  @relation(fields: [supplierRecordId], references: [id])
  providerProfile ProviderProfile? @relation(fields: [providerProfileId], references: [id], onDelete: SetNull)
  requestedBy     User?            @relation("ClaimRequestUser", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedBy      User?            @relation("ClaimReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([supplierRecordId])
  @@index([providerProfileId])
  @@index([status])
  @@index([requestedByEmail])
  @@index([expiresAt])
  @@map("claim_requests")
}

model SupplierIdentity {
  id                 String    @id @default(cuid())
  supplierRecordId   String
  userId             String?
  contactEmail       String
  ownershipStatus    String    @default("pending")
  verificationMethod String
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  supplier SupplierRecord @relation(fields: [supplierRecordId], references: [id])
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([supplierRecordId])
  @@index([userId])
  @@index([ownershipStatus])
  @@map("supplier_identities")
}

model ModerationLog {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String?
  verdict      String
  source       String
  categories   String[] @default([])
  reason       String?  @db.Text
  matchedTerms String[] @default([])
  textSample   String?  @db.Text
  model        String?
  latencyMs    Int?
  actorUserId  String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([verdict])
  @@index([createdAt])
  @@map("moderation_logs")
}

// Lightweight audit trail for AI features. Store operational metadata only;
// avoid raw user/provider text so prompts with personal data don't become
// another long-lived data surface.
model AiRun {
  id            String   @id @default(cuid())
  feature       String
  status        String
  provider      String?
  model         String?
  promptVersion String?
  latencyMs     Int?
  actorUserId   String?
  entityType    String?
  entityId      String?
  errorCode     String?
  metadataJson  String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([feature, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("ai_runs")
}

// Admin-editable per-touchpoint overrides for AI model + prompts.
// Draft fields are edited freely; production reads ONLY the active* fields,
// which are populated when an admin explicitly activates the draft. When both
// active fields are null the code defaults apply.
model AiTouchpointConfig {
  id                String    @id @default(cuid())
  touchpointId      String    @unique
  draftModel        String?
  draftPromptsJson  String?   @db.Text
  activeModel       String?
  activePromptsJson String?   @db.Text
  activatedAt       DateTime?
  updatedAt         DateTime  @updatedAt
  updatedBy         String?

  @@map("ai_touchpoint_configs")
}

// ═══════════════════════════════════════════════════════════════════════
// Phase 4 — pay-per-lead credit model
// ═══════════════════════════════════════════════════════════════════════

model CreditPack {
  id         String   @id @default(cuid())
  name       String
  credits    Int
  priceCents Int
  currency   String   @default("eur")
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("credit_packs")
}

model CreditTransaction {
  id                      String   @id @default(cuid())
  providerProfileId       String
  amount                  Int // signed: + grant/purchase, - spend
  balanceAfter            Int
  type                    String // PURCHASE | UNLOCK_SPEND | ADMIN_GRANT | STARTER_GRANT | CATEGORY_UNLOCK
  note                    String?
  requestId               String? // reference only (no FK — ledger rows are immutable history)
  categoryId              String? // reference only — set for CATEGORY_UNLOCK rows
  creditPackId            String?
  stripeCheckoutSessionId String?  @unique // idempotency key for purchases
  adminUserId             String?
  createdAt               DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, createdAt])
  @@map("credit_transactions")
}

model LeadUnlock {
  id                String   @id @default(cuid())
  requestId         String
  providerProfileId String
  source            String   @default("unlock") // unlock | legacy
  createdAt         DateTime @default(now())

  request         ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@unique([requestId, providerProfileId])
  @@index([providerProfileId])
  @@index([requestId])
  @@map("lead_unlocks")
}

// Emails received via the Resend inbound webhook. Every inbound message is
// persisted here as an audit trail; a copy is routed into a conversation
// thread when the recipient address carries a valid reply token, otherwise
// it stays in the admin support inbox.
model InboundEmail {
  id              String   @id @default(cuid())
  resendEmailId   String   @unique // Resend's email_id — also the idempotency key
  messageId       String? // RFC Message-ID header
  fromAddress     String
  toAddress       String // the recipient address the webhook delivered to
  subject         String?
  textBody        String?  @db.Text
  htmlBody        String?  @db.Text
  status          String   @default("INBOX") // INBOX | ROUTED | IGNORED
  routedMessageId String? // Message.id when status = ROUTED
  createdAt       DateTime @default(now())

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("inbound_emails")
}

// Conversation state for the Telegram request bot. Keyed by the Telegram user
// id so each chat has exactly one in-flight draft. Additive only — no existing
// table is touched. `draft` holds the partially-built užklausa until publish.
model TelegramSession {
  telegramUserId BigInt   @id
  chatId         BigInt
  userId         String?
  state          String   @default("idle")
  draft          Json?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("telegram_sessions")
}
