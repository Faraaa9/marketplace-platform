# Database
DATABASE_URL="postgresql://user:password@localhost:5432/marketplace"
# Supabase/Vercel pooled example:
# DATABASE_URL="postgresql://user:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — Sign in with Google
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: ${NEXTAUTH_URL}/api/auth/callback/google
# (e.g. http://localhost:3000/api/auth/callback/google for dev,
#       https://www.paslaugurinka.lt/api/auth/callback/google for prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend
RESEND_API_KEY="re_..."
EMAIL_FROM="PaslaugųRinka <onboarding@resend.dev>"
EMAIL_REPLY_TO=""

# Resend inbound email (receiving) — https://resend.com/docs/dashboard/receiving/introduction
# Signing secret of the Resend webhook (Webhooks → your webhook → Signing Secret).
RESEND_WEBHOOK_SECRET="whsec_..."
# Domain Resend receives inbound mail on — the <id>.resend.app domain from the
# Receiving tab, or your own subdomain (e.g. inbound.paslaugurinka.lt) once its
# MX record points at Resend. Reply-To addresses are built on this domain.
INBOUND_EMAIL_DOMAIN=""
# Support emails (not routed into a conversation) are forwarded here.
# Falls back to EMAIL_REPLY_TO when empty.
INBOUND_FORWARD_TO=""
# HMAC secret for signing reply-to tokens. Optional — falls back to NEXTAUTH_SECRET.
INBOUND_REPLY_SECRET=""

# Telnyx (SMS telefono patvirtinimui)
# Telnyx numeris turi būti SMS-enabled ir priskirtas Messaging Profile.
TELNYX_API_KEY=""
TELNYX_FROM_NUMBER="+370..."
TELNYX_MESSAGING_PROFILE_ID=""

# Upstash Redis (rate limiting — required for production/Vercel)
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."
# Vercel Marketplace Upstash injects these names instead; either pair works.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Optional: set to "1" in non-Vercel production runtimes if you want an explicit
# warning when Redis is missing and rate limiting falls back to per-instance memory.
RATE_LIMIT_WARN_ON_MEMORY=""

# OpenRouter (AI — užklausos aprašymo tvarkymas)
# Raktą sukurti: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Neprivaloma — modelis (numatytasis: anthropic/claude-haiku-4.5)
OPENROUTER_MODEL=""
# Neprivaloma — paveikslėlių modelis (profilio nuotraukų apdorojimas)
OPENROUTER_IMAGE_MODEL=""

# TypeSafe / Jev — structured marketplace decisions.
# Create a key in the TypeSafe console. Server-side only; never expose it with
# a NEXT_PUBLIC_ prefix. The admin lab uses an explicitly labelled local demo
# when this is empty.
TYPESAFE_API_KEY=""
# Pin a versioned id; aliases like jev-latest change behaviour on release.
TYPESAFE_DEFAULT_MODEL="jev-1.14.0"
# Observational only: evaluates newly created requests without changing their
# categories, provider visibility, notifications, or payments.
TYPESAFE_SHADOW_ENABLED="false"

# Multi-routing v4 — SHADOW mode (Phase 1).
# When "true", every created request also computes v4 routing and writes a
# routing_decision_logs row for off-line comparison. OBSERVATIONAL ONLY: it
# never changes provider notifications, lead visibility, or payments.
# Default off → production behavior is unchanged unless explicitly enabled.
# Requires the routing_decision_logs table (run `pnpm db:push` or apply
# prisma/manual-migrations/20260608_add_routing_decision_logs.sql first).
ROUTING_SHADOW_ENABLED="false"

# Routing Review Queue (human-in-the-loop corrections, multi-routing v4).
# Default off. The automatic enqueue hook runs inside shadow routing, so it
# also requires ROUTING_SHADOW_ENABLED=true. Requires the routing_review_items
# table (run `pnpm db:push` or apply
# prisma/manual-migrations/20260610_add_routing_review_items.sql first).
ROUTING_REVIEW_QUEUE_ENABLED="false"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Cron — shared secret for internal cron endpoints (claims/expire,
# cleanup-pending-requests, cleanup-orphan-images). REQUIRED in production:
# Vercel only sends the bearer when this is set; without it every run is 401.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Supabase Realtime (browser subscription to messages / notifications tables)
# Project URL and anon (publishable) key from the Supabase Dashboard.
# Safe to expose: writes still go through Next.js API; the anon key only
# opens the Realtime websocket, JWT below authorizes payload delivery.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# JWT secret used by /api/realtime/token to sign short-lived authorization
# tokens for Realtime subscribers. Must match Supabase's project JWT secret
# (Dashboard -> Project Settings -> API -> "JWT Secret"). Keep server-side
# only — never expose with NEXT_PUBLIC_ prefix. Without it Realtime falls
# back to anon, RLS blocks all payloads on messages/notifications.
# Supabase Dashboard -> Project Settings -> API -> JWT Secret.
# Must be the raw JWT Secret, not the anon key or service-role key.
SUPABASE_JWT_SECRET=""

# Telegram bot (užklausų teikimas per Telegram)
# Bot token from @BotFather (Telegram). Format: "<bot_id>:<hash>".
TELEGRAM_BOT_TOKEN=""
# Shared secret echoed by Telegram in the x-telegram-bot-api-secret-token
# header on every webhook call — the webhook route rejects mismatches.
# Generate with: openssl rand -hex 32
# Register the webhook once with: pnpm telegram:set-webhook
TELEGRAM_WEBHOOK_SECRET=""
# Telegram user ids exempt from the posting rate limits (AI-improve 15/h,
# photos 20/h). Comma-separated numeric ids. Use for the team's own
# posting/test account so QA isn't throttled. Leave empty in normal operation.
TELEGRAM_UNRESTRICTED_USER_IDS=""
# Bot username (without @) for the "Login with Telegram" widget and deep links.
# Either name works; NEXT_PUBLIC_ is the fallback.
TELEGRAM_BOT_USERNAME=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Optional: base URL of login links the bot sends (defaults to NEXTAUTH_URL).
TELEGRAM_LOGIN_RETURN_URL=""

# Google Search Console — site ownership verification.
# Search Console -> Add property -> "HTML tag" method gives a
# <meta name="google-site-verification" content="XXXX"> — paste only XXXX here.
GOOGLE_SITE_VERIFICATION=""

# Google Analytics 4 — Measurement ID, format "G-XXXXXXXXXX"
# (Analytics -> Admin -> Data Streams -> Web). NEXT_PUBLIC_ so the
# gtag loader can read it client-side.
NEXT_PUBLIC_GA_ID=""

# Error alerts (src/instrumentation.ts, cron failures) — emailed through Resend,
# rate-limited per error. Falls back to INBOUND_FORWARD_TO, then EMAIL_REPLY_TO.
ALERT_EMAIL=""

# Offline scripts only (not read by the app)
# scripts/seo-check.ts target
SEO_CHECK_BASE_URL="http://localhost:3000"
# scripts/eval-category-*.ts: also call the AI model
EVAL_AI=""
EVAL_WITH_AI=""
# Phrase index path for scripts/build-phrase-*.{ts,js}
PHRASE_STATS_PATH=""
# "1" = disable confidence calibration (used when fitting a new calibration)
CATEGORY_CALIB_RAW=""
