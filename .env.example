# Database
DATABASE_URL="postgresql://user:password@localhost:5432/marketplace"
# Supabase/Vercel pooled example:
# DATABASE_URL="postgresql://user:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — Sign in with Google
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: ${NEXTAUTH_URL}/api/auth/callback/google
# (e.g. http://localhost:3000/api/auth/callback/google for dev,
#       https://www.paslaugurinka.lt/api/auth/callback/google for prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_BASIC_PRICE_ID="price_..."
STRIPE_PRO_PRICE_ID="price_..."

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend
RESEND_API_KEY="re_..."
EMAIL_FROM="PaslaugųRinka <onboarding@resend.dev>"
EMAIL_REPLY_TO=""

# Upstash Redis (rate limiting — required for production/Vercel)
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Cron — shared secret for internal cron endpoints (claims/expire, cleanup-pending-requests)
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Supabase Realtime (browser subscription to messages table)
# Project URL and anon (publishable) key from the Supabase Dashboard.
# Safe to expose: writes still go through Next.js API; the anon key only
# enables Realtime INSERT subscriptions filtered by responseId.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
